# Nada de esta carpeta se sirve: guarda la URL del webhook del CRM, las marcas
# de envío del formulario y su registro. La regla del .htaccess raíz la cierra
# también; esto es la segunda capa por si aquella falla.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
